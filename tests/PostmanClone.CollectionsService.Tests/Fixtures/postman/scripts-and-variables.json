{
  "info": {
    "_postman_id": "55555555-5555-4555-8555-555555555555",
    "name": "Scripts and variables",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    { "listen": "prerequest", "script": { "type": "text/javascript", "exec": ["pm.variables.set('x', 1);"] } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://example.invalid" }
  ],
  "item": [
    {
      "name": "Folder with a variable",
      "variable": [{ "key": "folderVar", "value": "1" }],
      "item": [
        {
          "name": "Checked request",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('ok', () => {});"] } }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/checked"
          }
        }
      ]
    }
  ]
}
