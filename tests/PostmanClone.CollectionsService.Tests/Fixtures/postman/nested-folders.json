  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Admin",
          "item": [
            {
              "name": "List admins",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "https://example.invalid/users/admins?page=1",
                  "protocol": "https",
                  "host": ["example", "invalid"],
                  "path": ["users", "admins"],
                  "query": [
                    { "key": "page", "value": "1" },
                    { "key": "size", "value": "20", "disabled": true }
                  ]
                },
                "header": [
                  { "key": "Accept", "value": "application/json" }
                ]
              }
            }
          ]
        },
        {
          "name": "Get user",
          "request": {
            "method": "GET",
            "url": "https://example.invalid/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Health",
