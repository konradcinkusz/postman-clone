<Project Sdk="Microsoft.NET.Sdk">
  <!-- bUnit for components, WebApplicationFactory for the host (BLAZOR-WEB-APP §13). No network, no browser. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>PostmanClone.Web.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\PostmanClone.Web\PostmanClone.Web.csproj" />
    <ProjectReference Include="..\PostmanClone.TestKit\PostmanClone.TestKit.csproj" />
    <!-- CollectionsService's types, for the round-trip test only (CONTRACTS §5). The alias keeps its global Program out of
         this project: the Web host's Program is what WebApplicationFactory<Program> names. -->
    <ProjectReference Include="..\..\src\PostmanClone.CollectionsService\PostmanClone.CollectionsService.csproj" Aliases="collections" />
    <!-- EnvironmentsService's types, for the round-trip and rule-parity tests only (CONTRACTS §3). Same alias rule as above. -->
    <ProjectReference Include="..\..\src\PostmanClone.EnvironmentsService\PostmanClone.EnvironmentsService.csproj" Aliases="environments" />
    <!-- ExecutionService's types, for the send round-trip test only (CONTRACTS §4). Same alias rule as above. -->
    <ProjectReference Include="..\..\src\PostmanClone.ExecutionService\PostmanClone.ExecutionService.csproj" Aliases="execution" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
</Project>
