@using PostmanClone.Web.Builder

@* The HTTP method of the request (CONTRACTS §1). It raises the new value and holds nothing of its own. *@

<div class="field method-field">
    <label for="builder-method">Method</label>
    <select id="builder-method" data-testid="builder-method" disabled="@Disabled" @onchange="OnChange">
        @foreach (var method in BuilderChoices.Methods)
        {
            <option value="@method" selected="@(method == Value)">@method</option>
        }
    </select>
</div>

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = "GET";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private Task OnChange(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString() ?? "GET");
}
