@using PostmanClone.Web.Builder

@* The line under a secret field (ADR-0006): the rule, and the refusal when the field holds a literal. It never shows the value. *@

<p class="hint" id="@Id">@BuilderMessages.ReferenceOnlyHint</p>
@if (Refused)
{
    <p class="field-error" role="alert" data-testid="@TestId">@BuilderMessages.SecretLiteral</p>
}

@code {
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter]
    public bool Refused { get; set; }

    [Parameter, EditorRequired]
    public string TestId { get; set; } = string.Empty;
}
