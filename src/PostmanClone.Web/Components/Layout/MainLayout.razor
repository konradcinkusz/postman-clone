@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using PostmanClone.Web.Components.Environments
@inherits LayoutComponentBase
@inject WorkspaceState Workspace
@inject AuthenticationStateProvider AuthenticationState
@inject AntiforgeryStateProvider Antiforgery
@inject NavigationManager Navigation

<a class="skip-link" href="#main">Skip to content</a>

<header class="topbar">
    <a class="brand" href="/">PostmanClone</a>
    <span class="badge" data-testid="workspace-badge">@Workspace.Label</span>
    @if (Workspace.IsAuthenticated)
    {
        <form method="post" action="/sign-out" data-testid="sign-out-form">
            <input type="hidden" name="@_token?.FormFieldName" value="@_token?.Value" />
            <button type="submit" class="btn" data-testid="sign-out">Sign out</button>
        </form>
    }
    <EnvironmentSelector />
</header>

<StatusStrip />

<div class="shell">
    <nav class="nav" aria-label="Main">
        <ul class="stack">
            @foreach (var item in NavItems.All)
            {
                <li>
                    <NavLink href="@item.Href" Match="NavLinkMatch.All">@item.Label</NavLink>
                </li>
            }
        </ul>
    </nav>
    <main id="main" class="content" tabindex="-1">
        @if (_decision == WorkspaceDecision.Continue)
        {
            @Body
        }
        else
        {
            <p data-testid="workspace-redirecting">Redirecting to the workspace page…</p>
        }
    </main>
</div>

@code {
    private AntiforgeryRequestToken? _token;

    /// <summary>Computed at each render, so a page change or a changed session is seen without a reload.</summary>
    private WorkspaceDecision _decision = WorkspaceDecision.Continue;

    protected override async Task OnInitializedAsync()
    {
        await Workspace.CaptureAsync(AuthenticationState);
        _token = Antiforgery.GetAntiforgeryToken();
    }

    protected override void OnParametersSet()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        var query = path.IndexOfAny(['?', '#']);
        _decision = WorkspaceRouting.Decide("/" + (query < 0 ? path : path[..query]), Workspace.IsAuthenticated, Workspace.Resolution);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_decision == WorkspaceDecision.RedirectToNoWorkspace)
        {
            Navigation.NavigateTo(WorkspaceRouting.NoWorkspacePath);
        }
    }
}
